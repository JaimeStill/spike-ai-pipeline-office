<Project Sdk="Microsoft.NET.Sdk">

  <!-- The baseline tier's harness, which `mise run baseline` builds and runs on the laptop, never
       in CI: it runs office over the committed pool and scores its Markdown against the ground
       truth. It references no project of the CLI's, so Markdig, its
       Markdown parser, never reaches the shipped binary. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.1" />
  </ItemGroup>

  <!-- The scorer is internal; its tests, which the check runs, reach it from their project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SpikeAiPipeline.Office.Baseline.Tests" />
  </ItemGroup>

</Project>
