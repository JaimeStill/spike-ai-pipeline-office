<Project Sdk="Microsoft.NET.Sdk">

  <!-- The CLI publishes as one NativeAOT binary per runtime identifier, with no .NET runtime
       needed on the host. The binary is spike-ai-pipeline-office; the project and its namespaces
       keep .NET's naming. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>spike-ai-pipeline-office</AssemblyName>
    <RootNamespace>SpikeAiPipeline.Office</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

</Project>
